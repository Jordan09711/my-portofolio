# Copy this file to ".env" and fill in your own values. ".env" is git-ignored.
# Load it with: uvicorn main:app --reload --env-file .env

# Contact delivery (all SMTP_* values are required to enable sending email)
CONTACT_EMAIL=your-inbox@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=portfolio@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional social links (remove any you do not want displayed)
SOCIAL_LINKEDIN=https://www.linkedin.com/in/your-profile
SOCIAL_GITHUB=https://github.com/your-username
SOCIAL_BEHANCE=https://www.behance.net/your-profile
